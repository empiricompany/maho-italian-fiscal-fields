<config>
    <sections>
        <customer>
            <groups>
                <italianfiscalfields translate="label" module="italianfiscalfields">
                    <label>Customer Address Fiscal Fields</label>
                    <sort_order>900</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <codfisc_private_enabled translate="label comment">
                            <label>Show Codice Fiscale for Private customers</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <comment>When enabled, the Codice Fiscale field is also shown for private (non-company) customers.</comment>
                        </codfisc_private_enabled>
                        <default_customer_type translate="label comment">
                            <label>Default Customer Type (new address)</label>
                            <frontend_type>select</frontend_type>
                            <source_model>italianfiscalfields/source_customerType</source_model>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <comment>Default customer type preselected for new addresses. Existing addresses use their saved VAT ID to decide (company if a VAT ID is present).</comment>
                        </default_customer_type>
                    </fields>
                </italianfiscalfields>
            </groups>
        </customer>
    </sections>
</config>
